#!/usr/bin/env bash

# daeshift: start an agent session in a project, list, add or pull the
# projects, or set up, update or roll back daeshift on this machine.
# Projects live in $DAESHIFT_HOME/local/projects/ (DAESHIFT_HOME defaults
# to ~/.daeshift), and $DAESHIFT_HOME/local/config.yaml names the agent
# tool to start (runner: pi). Run "daeshift --help" for usage.

set -o nounset
set -o pipefail

readonly NAME_PATTERN='^[A-Za-z0-9][A-Za-z0-9._-]*$'

# Every outside program daeshift runs. check_dependencies reports each
# missing one before any work starts.
dependencies=(dirname)

### Helpers begin
err() { echo "[!] $*" >&2; }
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Prints the name of each folder in $1, one per line. Fails if $1 is not
# a folder.
list_folders() {
  local folder

  if [[ ! -d "$1" ]]; then
    err "$1 does not exist. Create it, then try again."
    return 1
  fi
  for folder in "$1"/*/; do
    if [[ -d "${folder}" ]]; then
      folder="${folder%/}"
      echo "${folder##*/}"
    fi
  done
}

main() {
  local add_url=""
  local code_dir
  local daeshift_home="${HOME}/.daeshift"
  local install="false"
  local installer=()
  local list="false"
  local name=""
  local project=""
  local pull="false"
  local puller=()
  local quiet="false"
  local release=""
  local script_dir
  local update="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "--add-project")
        if [[ $# -lt 2 || -z "$2" ]]; then
          usage 1 >&2
        fi
        add_url="$2"
        shift
        ;;
      "-h"|"--help") usage 0 ;;
      "--install") install="true" ;;
      "--list-projects") list="true" ;;
      "--name")
        if [[ $# -lt 2 ]]; then
          usage 1 >&2
        fi
        name="$2"
        shift
        ;;
      "--project")
        if [[ $# -lt 2 ]]; then
          usage 1 >&2
        fi
        project="$2"
        shift
        ;;
      "--pull") pull="true" ;;
      # Only the installer and pull print progress, so -q is passed on.
      "-q"|"--quiet") quiet="true" ;;
      "--release")
        if [[ $# -lt 2 || -z "$2" ]]; then
          usage 1 >&2
        fi
        release="$2"
        shift
        ;;
      "--update") update="true" ;;
      *) usage 1 >&2 ;;
    esac
    shift
  done
  if [[ -n "${name}" && -z "${add_url}" ]] \
    || [[ "${pull}" == "true" && -z "${project}" ]] \
    || [[ "${pull}" == "true" && -n "${add_url}" ]]; then
    usage 1 >&2
  fi
  if [[ -n "${DAESHIFT_HOME:-}" ]]; then
    daeshift_home="${DAESHIFT_HOME}"
  fi

  check_dependencies || exit 1
  script_dir="$(dirname "$0")" || exit 1
  code_dir="$(cd "${script_dir}/.." && pwd)" || exit 1
  if [[ "${install}" == "true" || "${update}" == "true" \
    || -n "${release}" ]]; then
    installer=("${code_dir}/libexec/install")
    if [[ "${quiet}" == "true" ]]; then
      installer+=("--quiet")
    fi
    # --release wins over --update, which wins over --install.
    if [[ -n "${release}" ]]; then
      installer+=("--release" "${release}")
    elif [[ "${update}" == "true" ]]; then
      installer+=("--update")
    fi
    exec "${installer[@]}"
  elif [[ -n "${add_url}" || "${pull}" == "true" ]]; then
    puller=("${code_dir}/libexec/pull")
    if [[ "${quiet}" == "true" ]]; then
      puller+=("--quiet")
    fi
    if [[ -n "${add_url}" ]]; then
      puller+=("--add" "${add_url}" "--name" "${name}")
    else
      puller+=("--project" "${project}")
    fi
    exec "${puller[@]}"
  elif [[ "${list}" == "true" ]]; then
    list_folders "${daeshift_home}/local/projects" || exit 1
  elif [[ -n "${project}" ]]; then
    start_project "${daeshift_home}" "${project}" "${code_dir}" || exit 1
  else
    usage 1 >&2
  fi
}

# Prints the runner named by the runner key of YAML file $1, read with
# the pinned yq $2. The file is read as data, never run. Fails if the
# file, yq or the key is missing, yq cannot read the file, or the name
# is not a plain name.
read_runner() {
  local config="$1"
  local runner
  local yq="$2"

  if [[ ! -f "${config}" ]]; then
    err "${config} does not exist. Create it with the line: runner: pi"
    return 1
  fi
  if [[ ! -x "${yq}" ]]; then
    err "${yq} is missing or cannot be run. Run daeshift --install."
    return 1
  fi
  if ! runner="$("${yq}" '.runner // ""' "${config}")"; then
    err "${config} could not be read. Fix it, such as: runner: pi"
    return 1
  fi
  if [[ -z "${runner}" ]]; then
    err "${config} has no runner. Add one, such as: runner: pi"
    return 1
  fi
  if [[ ! "${runner}" =~ ${NAME_PATTERN} ]]; then
    err "${config}: runner '${runner}' is not a plain name."
    return 1
  fi
  echo "${runner}"
}

# Starts the configured runner in project $2 under DAESHIFT_HOME $1, by
# handing the process over to runners/<runner>/launch in code folder $3.
# Fails if the project or the runner does not exist.
start_project() {
  local code_dir="$3"
  local daeshift_home="$1"
  local launch
  local project="$2"
  local project_dir="$1/local/projects/$2"
  local runner

  if [[ ! "${project}" =~ ${NAME_PATTERN} || ! -d "${project_dir}" ]]; then
    err "No project '${project}' in ${daeshift_home}/local/projects." \
      "Available projects:"
    list_folders "${daeshift_home}/local/projects" >&2
    return 1
  fi
  runner="$(read_runner "${daeshift_home}/local/config.yaml" \
    "${daeshift_home}/local/tools/bin/yq")" || return 1
  launch="${code_dir}/runners/${runner}/launch"
  if [[ ! -x "${launch}" ]]; then
    err "No runner '${runner}' in ${code_dir}/runners. Available runners:"
    list_folders "${code_dir}/runners" >&2
    return 1
  fi
  cd "${project_dir}" || return 1
  exec "${launch}" "${code_dir}"
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: daeshift [OPTIONS]

DESCRIPTION
    Start an agent session in a project, list, add or pull the projects,
    or set up, update or roll back daeshift on this machine.

OPTIONS
        --add-project URL
                          Clone the project repo at URL and its code repos
    -h, --help            Display this help message
        --install         Set daeshift up on this machine, asking first
        --list-projects   List the projects
        --name NAME       With --add-project: the project's name (default:
                          the URL's last part without .git)
        --project NAME    Start a session in the project NAME
        --pull            With --project: fast-forward the project and its
                          code repos, cloning missing ones
    -q, --quiet           Show only warnings and errors
        --release TAG     Check out the release TAG, such as an older one
                          to roll back to, asking first
        --update          Check out the newest release, asking first

ENVIRONMENT
    DAESHIFT_HOME   Where local/config.yaml and local/projects/ live
                    (default: ~/.daeshift)
EOF
  exit "$1"
}

main "$@"
