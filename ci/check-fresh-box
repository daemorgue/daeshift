#!/usr/bin/env bash

# check-fresh-box: check that "daeshift --install" set this machine up:
# the layout under local/, each pinned tool at its pinned version, and
# each project's repos cloned, set up and readable by backlog and groma.
# With no --services, no service may be set up; with --services, each
# service in local/config.yaml must be active and answer on its port,
# each map must show its repo's tasks, and no other unit may be set up.
# --closed PORT also checks that nothing answers on PORT. Run by the
# fresh-box CI job; run "check-fresh-box --help" for usage.

set -o nounset
set -o pipefail

# One line per service in config.yaml: kind, project, repo ("-" for a
# board) and port, separated by tabs, as libexec/install reads them.
# $p is yq's, not the shell's.
# shellcheck disable=SC2016
readonly SERVICES_QUERY='(.projects // {}) | to_entries | .[] | .key as $p
  | ((select(.value.board != null)
      | "board\t" + $p + "\t-\t" + (.value.board | tostring)),
    ((.value.repos // {}) | to_entries | .[]
      | "map\t" + $p + "\t" + .key + "\t" + (.value | tostring)))'
# The paths every clone's exclude file lists (code-repos item 2).
readonly EXCLUDES=(groma AGENTS.md AGENTS.override.md CLAUDE.md .pi/)
# How long a service may take to answer after it started.
readonly WAIT_SECONDS=30

# Every outside program check-fresh-box runs. check_dependencies
# reports each missing one before any work starts.
dependencies=(cat curl cut dirname find git grep head jq readlink sed
  sleep sort systemctl tr wc)
failed="false"
quiet="false"
closed_port=""
services="false"

### Helpers begin
err() { echo "[!] $*" >&2; }

# Reports a failed check and goes on, so every failure is listed.
fail() {
  err "$*"
  failed="true"
}

good() {
  if [[ "${quiet}" == "false" ]]; then
    echo "[+] $*"
  fi
}
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Checks that each file and folder install creates exists. $1 is the
# local folder.
check_layout() {
  local path
  local paths=(
    "$1/config.yaml"
    "$1/projects/"
    "$1/tools/bin/bats"
    "$1/tools/bin/shellcheck"
    "$1/tools/bin/tiredize"
    "$1/tools/bin/yq"
    "$1/tools/installed-from"
    "$1/tools/node/node_modules/.bin/backlog"
    "$1/tools/node/node_modules/.bin/groma"
    "$1/tools/pre-commit/bin/pre-commit"
  )

  for path in "${paths[@]}"; do
    if [[ "${path}" == */ && ! -d "${path}" ]] \
      || [[ "${path}" != */ && ! -e "${path}" ]]; then
      fail "${path} is missing."
    fi
  done
  if [[ "${failed}" == "false" ]]; then
    good "local/ holds the config, the projects folder and the tools"
  fi
}

# Checks that config.yaml sets no service, that no board or map unit
# file exists where libexec/install writes them, and that no such unit
# is loaded in any state, since nothing is served without a port. $1 is
# the local folder.
check_no_services() {
  local clean="true"
  local configured
  local loaded
  local unit_file

  if ! configured="$("$1/tools/bin/yq" "${SERVICES_QUERY}" \
    "$1/config.yaml")"; then
    err "$1/config.yaml could not be read."
    return 1
  fi
  if [[ -n "${configured}" ]]; then
    fail "$1/config.yaml sets services; run with --services to check them."
    return
  fi
  for unit_file in "${HOME}"/.config/systemd/user/backlog-*.service \
    "${HOME}"/.config/systemd/user/groma-*.service; do
    if [[ -e "${unit_file}" ]]; then
      fail "${unit_file} is set up with no port set."
      clean="false"
    fi
  done
  if ! loaded="$(systemctl --user list-units --all --no-legend --plain \
    'backlog-*' 'groma-*')"; then
    err "systemctl could not list the user's units."
    return 1
  fi
  if [[ -n "${loaded}" ]]; then
    fail "A board or map unit is loaded with no port set: ${loaded}"
    clean="false"
  fi
  if [[ "${clean}" == "true" ]]; then
    good "No board or map service is set up or running"
  fi
}

# Checks that the map service of repo $3 of project $2, on port $4,
# pins each task of that repo that references an element of the repo's
# map to one of the elements it references, as groma pins a task once.
# $1 is the local folder. Waits up to WAIT_SECONDS for the service to
# pick the tasks up.
check_pins() {
  local deadline=$((SECONDS + WAIT_SECONDS))
  local element
  local elements=()
  local expected
  local file
  local missing
  local pinned
  local pins
  local project_dir="$1/projects/$2"
  local tasks

  # Each element is a Markdown file, at any depth, whose frontmatter
  # holds its ID at groma.id.
  while IFS= read -r file; do
    element="$("$1/tools/bin/yq" --front-matter=extract '.groma.id // ""' \
      "${file}")" || continue
    if [[ -n "${element}" ]]; then
      elements+=("${element}")
    fi
  done < <(find "${project_dir}/maps/$3" -name '*.md')
  if [[ "${#elements[@]}" -eq 0 ]]; then
    fail "The map of $3 has no element to pin a task to."
    return
  fi
  if ! tasks="$(cd "${project_dir}" \
    && "$1/tools/node/node_modules/.bin/backlog" task list --json)"; then
    fail "backlog could not list the tasks of ${project_dir}."
    return
  fi
  # One "TASK-ID element" line per reference of a task of repo $3 to an
  # element of its map. $repo, $id and $ARGS are jq's, not the shell's.
  # shellcheck disable=SC2016
  if ! expected="$(jq -r --arg repo "$3" --args \
    '.tasks[] | select(.project == $repo) | .id as $id
      | (.references // [])[] | select(IN($ARGS.positional[]))
      | "\($id) \(.)"' "${elements[@]}" <<<"${tasks}")"; then
    fail "The tasks of $3 could not be read from backlog's list."
    return
  fi
  if [[ -z "${expected}" ]]; then
    fail "No task of $3 references an element of its map."
    return
  fi
  while ((SECONDS < deadline)); do
    # The stream never ends, so curl stops at --max-time; its exit status
    # says nothing about the data it read.
    pins="$(curl --silent --no-buffer --max-time 2 \
        "http://127.0.0.1:$4/events" \
      | sed -n 's/^data: //p' \
      | head -n 1 \
      | jq -r '.pins[]? | "\(.taskId) \(.elementId)"' 2>/dev/null)"
    # The tasks with a pin on an element they reference, then those
    # without one.
    pinned="$(grep --fixed-strings --line-regexp \
        --file=<(printf '%s\n' "${pins}") <<<"${expected}" \
      | cut -d ' ' -f 1 \
      | sort -u)"
    missing="$(cut -d ' ' -f 1 <<<"${expected}" \
      | sort -u \
      | grep --fixed-strings --line-regexp --invert-match \
        --file=<(printf '%s\n' "${pinned}"))"
    if [[ -z "${missing}" ]]; then
      good "$3's map shows $(wc -l <<<"${pinned}" | tr -d ' ') task(s)" \
        "on elements they reference"
      return
    fi
    sleep 1
  done
  fail "The map of $3 on port $4 does not show $(tr '\n' ' ' \
    <<<"${missing}")after ${WAIT_SECONDS} s. Check the unit's journal."
}

# Checks each project in the projects folder: every repo its
# .config/repos.yaml lists is cloned, backlog reads the board and the
# next-task command runs, and groma reads each repo's map, all without
# a service. $1 is the local folder.
check_projects() {
  local bin="$1/tools/node/node_modules/.bin"
  local project
  local projects=0
  local repo
  local repos

  for project in "$1"/projects/*/; do
    if [[ ! -d "${project}" ]]; then
      continue
    fi
    project="${project%/}"
    projects=$((projects + 1))
    if ! (cd "${project}" && "${bin}/backlog" task list --plain \
      >/dev/null); then
      fail "backlog could not read the board of ${project}."
    elif ! (cd "${project}" && "${bin}/backlog" task list --json \
      | jq -r -f .config/next-task.jq >/dev/null); then
      fail "The next-task command failed in ${project}."
    else
      good "${project##*/}: backlog reads the board; next-task runs"
    fi
    if ! repos="$("$1/tools/bin/yq" '.repos[].name' \
      "${project}/.config/repos.yaml")"; then
      fail "${project}/.config/repos.yaml could not be read."
      continue
    fi
    if [[ -z "${repos}" ]]; then
      fail "${project}/.config/repos.yaml lists no repo."
      continue
    fi
    while IFS= read -r repo; do
      if [[ -z "${repo}" ]]; then
        continue
      fi
      check_repo "${bin}" "${project}/repositories/${repo}"
    done <<<"${repos}"
  done
  if [[ "${projects}" -eq 0 ]]; then
    fail "No project found in $1/projects."
  fi
}

# Checks one clone, $2: it is a git clone of its own, its exclude file
# lists EXCLUDES, its groma link points at its map in the project repo,
# and groma, from folder $1, reads that map. Reports each failure and
# goes on.
check_repo() {
  local exclude
  local exclude_file
  local missing=""

  # A folder that is not a clone would answer for the project repo
  # around it, so the clone must be its own top level.
  if [[ ! -e "$2/.git" ]]; then
    fail "$2 is not cloned."
    return
  fi
  if ! exclude_file="$(git -C "$2" rev-parse --path-format=absolute \
    --git-path info/exclude)"; then
    fail "The exclude file of $2 could not be found."
    return
  fi
  for exclude in "${EXCLUDES[@]}"; do
    if ! grep --quiet --fixed-strings --line-regexp -- "${exclude}" \
      "${exclude_file}" 2>/dev/null; then
      missing="${missing} ${exclude}"
    fi
  done
  if [[ -n "${missing}" ]]; then
    fail "${exclude_file} does not list:${missing}."
  fi
  if [[ "$(readlink "$2/groma")" != "../../maps/${2##*/}" ]]; then
    fail "$2/groma is not a link to ../../maps/${2##*/}."
  elif ! (cd "$2" && "$1/groma" view --plain >/dev/null); then
    fail "groma could not read the map of $2."
  elif [[ -z "${missing}" ]]; then
    good "${2##*/}: cloned and set up; groma reads its map"
  fi
}

# Checks that each service in config.yaml is active and answers on its
# port, that each map shows its repo's tasks on their elements, and that
# no unit is set up beyond those services. $1 is the local folder.
check_services() {
  local kind
  local loaded
  local name
  local port
  local project
  local repo
  local services
  local unit
  local unit_file
  local units=" "

  if ! services="$("$1/tools/bin/yq" "${SERVICES_QUERY}" \
    "$1/config.yaml")"; then
    err "$1/config.yaml could not be read."
    return 1
  fi
  if [[ -z "${services}" ]]; then
    fail "$1/config.yaml sets no service, so none was checked."
    return
  fi
  while IFS=$'\t' read -r kind project repo port; do
    if [[ "${kind}" == "board" ]]; then
      unit="backlog-${project}.service"
    else
      unit="groma-${project}-${repo}.service"
    fi
    units="${units}${unit} "
    if ! systemctl --user --quiet is-active "${unit}"; then
      fail "${unit} is not active."
    elif ! wait_for_port "${port}"; then
      fail "${unit} does not answer on port ${port}."
    else
      good "${unit} answers on port ${port}"
      if [[ "${kind}" == "map" ]]; then
        check_pins "$1" "${project}" "${repo}" "${port}"
      fi
    fi
  done <<<"${services}"
  # A service taken out of config.yaml leaves no unit behind.
  for unit_file in "${HOME}"/.config/systemd/user/backlog-*.service \
    "${HOME}"/.config/systemd/user/groma-*.service; do
    if [[ -e "${unit_file}" && "${units}" != *" ${unit_file##*/} "* ]]
    then
      fail "${unit_file} is set up, but config.yaml sets no such service."
    fi
  done
  if ! loaded="$(systemctl --user list-units --all --no-legend --plain \
    'backlog-*' 'groma-*')"; then
    err "systemctl could not list the user's units."
    return 1
  fi
  while read -r name _; do
    if [[ -n "${name}" && "${units}" != *" ${name} "* ]]; then
      fail "${name} is loaded, but config.yaml sets no such service."
    fi
  done <<<"${loaded}"
}

# Checks that one tool reports its pinned version: one word of what it
# reported, without a leading v, equals the pin. $1 is the tool's name,
# $2 the pin and $3 what the tool reported.
check_version() {
  local word
  local words

  if [[ -z "$2" || "$2" == "null" ]]; then
    fail "No pin was found for $1. Check its pin file."
    return
  fi
  if [[ -z "${3//[[:space:]]/}" ]]; then
    fail "$1 reported no version."
    return
  fi
  read -r -a words <<<"${3//$'\n'/ }"
  for word in "${words[@]}"; do
    if [[ "${word#v}" == "${2#v}" ]]; then
      good "$1 $2"
      return
    fi
  done
  fail "$1 reports '$3', not the pinned $2."
}

# Checks each pinned tool's version against the pin files in the code
# folder. $1 is the code folder, $2 the local folder.
check_versions() {
  local expected
  local lock="$1/requirements/npm/package-lock.json"
  local name
  local reported
  local tools="$2/tools"

  # A tool that fails to report leaves reported empty or partial, which
  # check_version reports as a mismatch, so the next tool is still
  # checked.
  expected="$(read_pin "$1/ci/install-tools" BATS_COMMIT)" || return 1
  reported="$(git -C "${tools}/bats-core" rev-parse HEAD)"
  check_version bats "${expected}" "${reported}"
  expected="$(read_pin "$1/ci/install-tools" SHELLCHECK_VERSION)" \
    || return 1
  reported="$("${tools}/bin/shellcheck" --version)"
  check_version ShellCheck "${expected}" "${reported}"
  expected="$(read_pin "$1/ci/install-tools" YQ_VERSION)" || return 1
  reported="$("${tools}/bin/yq" --version)"
  check_version yq "${expected}" "${reported}"
  for name in pre-commit tiredize; do
    expected="$(sed -n "s/^${name}==\([^ ]*\).*/\1/p" \
      "$1/requirements/${name}.txt")" || return 1
    reported="$("${tools}/${name}/bin/${name}" --version)"
    check_version "${name}" "${expected}" "${reported}"
  done
  for name in backlog groma; do
    expected="$(jq -r ".packages[\"node_modules/${name}.md\"].version" \
      "${lock}")" || return 1
    reported="$("${tools}/node/node_modules/.bin/${name}" --version)"
    check_version "${name}" "${expected}" "${reported}"
  done
}

main() {
  local code_folder
  local daeshift_home="${HOME}/.daeshift"
  local script_folder

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "-h"|"--help") usage 0 ;;
      "-q"|"--quiet") quiet="true" ;;
      "--closed")
        if [[ $# -lt 2 || ! "$2" =~ ^[0-9]+$ ]]; then
          usage 1 >&2
        fi
        closed_port="$2"
        shift
        ;;
      "--services") services="true" ;;
      *) usage 1 >&2 ;;
    esac
    shift
  done

  check_dependencies || exit 1
  script_folder="$(dirname "$0")" || exit 1
  code_folder="$(dirname "${script_folder}")" || exit 1
  if [[ -n "${DAESHIFT_HOME:-}" ]]; then
    daeshift_home="${DAESHIFT_HOME}"
  fi
  check_layout "${daeshift_home}/local"
  if [[ "${failed}" == "true" ]]; then
    exit 1
  fi
  check_versions "${code_folder}" "${daeshift_home}/local" || exit 1
  check_projects "${daeshift_home}/local" || exit 1
  if [[ "${services}" == "true" ]]; then
    check_services "${daeshift_home}/local" || exit 1
  else
    check_no_services "${daeshift_home}/local" || exit 1
  fi
  if [[ -n "${closed_port}" ]]; then
    if curl --silent --max-time 2 --output /dev/null \
      "http://127.0.0.1:${closed_port}/"; then
      fail "Port ${closed_port} still answers."
    else
      good "Nothing answers on port ${closed_port}"
    fi
  fi
  if [[ "${failed}" == "true" ]]; then
    exit 1
  fi
}

# Prints the value of one readonly NAME="value" line of a bash file.
# $1 is the file, $2 the name.
read_pin() {
  local value

  value="$(sed -n "s/^readonly $2=\"\([^\"]*\)\".*/\1/p" "$1")" \
    || return 1
  if [[ -z "${value}" ]]; then
    err "$1 has no $2."
    return 1
  fi
  echo "${value}"
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: check-fresh-box [OPTIONS]

DESCRIPTION
    Check that daeshift --install set this machine up: the layout under
    local/, the pinned tools' versions, each project's repos cloned, set
    up and read by backlog and groma, and either no service set up, or,
    with --services, each service in config.yaml answering.

OPTIONS
        --closed PORT
                     Also check that nothing answers on PORT
    -h, --help       Display this help message
    -q, --quiet      Show only warnings and errors
        --services   Check the services in config.yaml instead of their
                     absence: each answers, each map shows its repo's
                     tasks, and no other unit is set up

ENVIRONMENT
    DAESHIFT_HOME    The folder that holds local/ (default: ~/.daeshift)
EOF
  exit "$1"
}

# Waits up to WAIT_SECONDS for an HTTP answer on 127.0.0.1. $1 is the
# port. Fails when nothing answers.
wait_for_port() {
  local second

  for ((second = 0; second < WAIT_SECONDS; second++)); do
    if curl --silent --max-time 2 --output /dev/null \
      "http://127.0.0.1:$1/"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

main "$@"
