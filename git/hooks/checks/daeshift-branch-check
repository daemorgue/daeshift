#!/usr/bin/env bash

# daeshift-branch-check: reject a commit on a branch the project does not
# allow. pre-commit runs it at the pre-commit and pre-merge-commit
# stages, with no files. Run "daeshift-branch-check --help" for usage.

set -o nounset
set -o pipefail

# Every outside program the check runs. check_dependencies reports each
# missing one before any work starts.
dependencies=(git)
allow=()
deny=()

### Helpers begin
err() { echo "[!] $*" >&2; }
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Prints glob $1 as an anchored extended regular expression, matching
# the way GitHub's rulesets do: "*" and "?" never match "/", and "**"
# matches across it.
glob_to_regex() {
  local char
  local glob="$1"
  local index=0
  local regex="^"

  while [[ "${index}" -lt "${#glob}" ]]; do
    char="${glob:${index}:1}"
    if [[ "${glob:${index}:2}" == "**" ]]; then
      regex="${regex}.*"
      index=$((index + 2))
      continue
    fi
    case "${char}" in
      "*") regex="${regex}[^/]*" ;;
      "?") regex="${regex}[^/]" ;;
      "."|"^"|"$"|"+"|"("|")"|"["|"]"|"{"|"}"|"|"|"\\")
        regex="${regex}\\${char}"
        ;;
      *) regex="${regex}${char}" ;;
    esac
    index=$((index + 1))
  done
  echo "${regex}\$"
}

main() {
  local branch
  local reason

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "--allow")
        if [[ $# -lt 2 ]]; then
          usage 1 >&2
        fi
        allow+=("$2")
        shift
        ;;
      "--deny")
        if [[ $# -lt 2 ]]; then
          usage 1 >&2
        fi
        deny+=("$2")
        shift
        ;;
      "-h"|"--help") usage 0 ;;
      # The check prints only problems, so -q has nothing to hide.
      "-q"|"--quiet") ;;
      *) usage 1 >&2 ;;
    esac
    shift
  done
  # With no globs, main and master are denied.
  if [[ "${#allow[@]}" -eq 0 && "${#deny[@]}" -eq 0 ]]; then
    deny=("main" "master")
  fi

  check_dependencies || exit 1
  # A detached HEAD (rebase, bisect) is on no branch.
  if ! branch="$(git symbolic-ref --quiet --short HEAD)"; then
    exit 0
  fi
  # A new repo's first commit has to land on its first branch.
  if ! git rev-parse --quiet --verify HEAD >/dev/null; then
    exit 0
  fi
  reason=""
  if [[ "${#deny[@]}" -gt 0 ]] && matches_any "${branch}" "${deny[@]}"
  then
    reason="Denied branches: ${deny[*]}"
  elif [[ "${#allow[@]}" -gt 0 ]] && ! matches_any "${branch}" "${allow[@]}"
  then
    reason="Allowed branches: ${allow[*]}"
  fi
  if [[ -z "${reason}" ]]; then
    exit 0
  fi
  if [[ "${branch}" == "main" || "${branch}" == "master" ]]; then
    err "Commits on ${branch} are not allowed in a code repo. Create a" \
      "task branch first: git switch -c tasks/<id>-<slug>"
  else
    err "Commits on ${branch} are not allowed. ${reason}"
  fi
  exit 1
}

# Answers whether branch $1 matches any of the globs that follow.
matches_any() {
  local branch="$1"
  local glob
  local regex

  shift
  for glob in "$@"; do
    regex="$(glob_to_regex "${glob}")"
    if [[ "${branch}" =~ ${regex} ]]; then
      return 0
    fi
  done
  return 1
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: daeshift-branch-check [OPTIONS]

DESCRIPTION
    Reject a commit on a branch matching a --deny glob, or matching no
    --allow glob when any is given. With neither, main and master are
    denied. In a glob, * and ? never match /, and ** matches across it.
    A detached HEAD and a new repo's first commit are always allowed.

OPTIONS
        --allow GLOB     Allow only branches matching GLOB (repeatable)
        --deny GLOB      Deny branches matching GLOB (repeatable)
    -h, --help           Display this help message
    -q, --quiet          Show only warnings and errors
EOF
  exit "$1"
}

main "$@"
