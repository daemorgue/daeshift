#!/usr/bin/env bash

# daeshift-branch-check: reject a commit on a branch the project does not
# allow. pre-commit runs it at the pre-commit and pre-merge-commit
# stages, with no files. Run "daeshift-branch-check --help" for usage.

set -o nounset
set -o pipefail

# Every outside program the check runs. check_dependencies reports each
# missing one before any work starts.
dependencies=(git)
allow=()
deny=()

### Helpers begin
err() { echo "[!] $*" >&2; }
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Prints why branch $1 is not allowed ("Denied branches: ..." or
# "Allowed branches: ..."), and prints nothing when it is allowed.
find_reason() {
  if [[ "${#deny[@]}" -gt 0 ]] && matches_any "$1" "${deny[@]}"; then
    echo "Denied branches: ${deny[*]}"
  elif [[ "${#allow[@]}" -gt 0 ]] && ! matches_any "$1" "${allow[@]}"
  then
    echo "Allowed branches: ${allow[*]}"
  fi
}

# Prints glob $1 as an anchored extended regular expression, matching
# the way GitHub's rulesets do (fnmatch with FNM_PATHNAME): "*" and "?"
# never match "/", "**/" matches zero or more whole folders, a "**" not
# followed by "/" acts as "*". Character classes ("[0-9]") are not
# supported: "[" and "]" match themselves.
glob_to_regex() {
  local char
  local glob="$1"
  local index=0
  local regex="^"

  while [[ "${index}" -lt "${#glob}" ]]; do
    char="${glob:${index}:1}"
    # "**/" is special only at the start of a folder name.
    if [[ "${glob:${index}:3}" == "**/" ]] \
      && [[ "${index}" -eq 0 || "${glob:$((index - 1)):1}" == "/" ]]; then
      regex="${regex}(.*/)?"
      index=$((index + 3))
      continue
    fi
    if [[ "${glob:${index}:2}" == "**" ]]; then
      regex="${regex}[^/]*"
      index=$((index + 2))
      continue
    fi
    case "${char}" in
      "*") regex="${regex}[^/]*" ;;
      "?") regex="${regex}[^/]" ;;
      # A one-character bracket expression matches the character itself
      # in every POSIX regex engine. git forbids "^", "[" and "\" in
      # branch names, so a glob holding them matches nothing.
      "."|"$"|"+"|"("|")"|"]"|"{"|"}"|"|") regex="${regex}[${char}]" ;;
      "^"|"["|"\\") regex="${regex}\\${char}" ;;
      *) regex="${regex}${char}" ;;
    esac
    index=$((index + 1))
  done
  echo "${regex}\$"
}

# Answers whether a rebase or a bisect is under way in this repo.
in_rebase_or_bisect() {
  local path

  for path in rebase-merge rebase-apply BISECT_LOG; do
    if [[ -e "$(git rev-parse --git-path "${path}")" ]]; then
      return 0
    fi
  done
  return 1
}

main() {
  local branch
  local reason

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "--allow")
        if [[ $# -lt 2 ]]; then
          usage 1 >&2
        fi
        allow+=("$2")
        shift
        ;;
      "--deny")
        if [[ $# -lt 2 ]]; then
          usage 1 >&2
        fi
        deny+=("$2")
        shift
        ;;
      "-h"|"--help") usage 0 ;;
      # The check prints only problems, so -q has nothing to hide.
      "-q"|"--quiet") ;;
      "-"*) usage 1 >&2 ;;
      *)
        err "daeshift-branch-check takes no files. Give its hook" \
          "pass_filenames: false."
        exit 1
        ;;
    esac
    shift
  done
  # With no globs, main and master are denied.
  if [[ "${#allow[@]}" -eq 0 && "${#deny[@]}" -eq 0 ]]; then
    deny=("main" "master")
  fi

  check_dependencies || exit 1
  git rev-parse --git-dir >/dev/null || exit 1
  # A new repo's first commit, before any branch or tag exists.
  if [[ -z "$(git for-each-ref --count=1)" ]]; then
    exit 0
  fi
  # At pre-push, pre-commit names the branch being pushed.
  if [[ -n "${PRE_COMMIT_LOCAL_BRANCH:-}" ]]; then
    branch="${PRE_COMMIT_LOCAL_BRANCH#refs/heads/}"
  elif ! branch="$(git symbolic-ref --quiet --short HEAD)"; then
    # A rebase or bisect runs on a detached HEAD; other commits there
    # are on no allowed branch.
    if in_rebase_or_bisect; then
      exit 0
    fi
    err "Commits on a detached HEAD are not allowed. Switch to a branch" \
      "first."
    exit 1
  fi
  reason="$(find_reason "${branch}")"
  if [[ -z "${reason}" ]]; then
    exit 0
  fi
  err "Commits on ${branch} are not allowed. ${reason}"
  if [[ -z "$(find_reason "tasks/task-1-example")" ]]; then
    err "Create a task branch first: git switch -c tasks/<id>-<slug>"
  fi
  exit 1
}

# Answers whether branch $1 matches any of the globs that follow.
matches_any() {
  local branch="$1"
  local glob
  local regex

  shift
  for glob in "$@"; do
    regex="$(glob_to_regex "${glob}")"
    if [[ "${branch}" =~ ${regex} ]]; then
      return 0
    fi
  done
  return 1
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: daeshift-branch-check [OPTIONS]

DESCRIPTION
    Reject a commit on a branch matching a --deny glob, or matching no
    --allow glob when any is given. With neither, main and master are
    denied. In a glob, * and ? never match /, **/ matches any folders,
    as in GitHub's rulesets; character classes are not supported.
    A new repo's first commit, and a detached HEAD during a rebase or
    bisect, are always allowed.

OPTIONS
        --allow GLOB     Allow only branches matching GLOB (repeatable)
        --deny GLOB      Deny branches matching GLOB (repeatable)
    -h, --help           Display this help message
    -q, --quiet          Show only warnings and errors
EOF
  exit "$1"
}

main "$@"
