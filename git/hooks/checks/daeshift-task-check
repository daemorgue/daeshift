#!/usr/bin/env bash

# daeshift-task-check: reject a commit in a code repo unless its branch
# names a task that is ready to be worked (decisions 3, 8 and 11): on
# the project's board, In Progress, with acceptance criteria, for this
# repo, with no subtasks and no unfinished dependency. pre-commit runs
# it at the pre-commit and pre-merge-commit stages, with no files. Fails
# closed: when the board cannot be read, the commit is rejected. Run
# "daeshift-task-check --help" for usage.

set -o nounset
set -o pipefail

# The task part of a branch name: tasks/task-<n>[.<m>...][-<slug>].
readonly BRANCH_TASK='^tasks/task-([0-9]+(\.[0-9]+)*)(-|$)'
# Prints every reason task $id cannot be worked in repo $repo, one per
# line, and nothing when it can. Dependencies are judged by backlog's
# isReady, since its task list carries no dependency list. The $ names
# are jq's.
# shellcheck disable=SC2016
readonly FIND_REASONS='
  .tasks as $all
  | ([$all[] | select(.id == $id)][0]) as $task
  | if $task == null then "\($id) is not on the board."
    else
      (if $task.status != "In Progress"
       then "\($id) is \($task.status), not In Progress." else empty end),
      (if ($task.acceptanceCriteriaCount // 0) == 0
       then "\($id) has no acceptance criteria." else empty end),
      (if ($task.project // "") != $repo
       then "\($id) belongs to project \"\($task.project // "")\","
         + " not \"\($repo)\"."
       else empty end),
      (if any($all[]; .parentTaskId == $id)
       then "\($id) has subtasks; work one of them instead." else empty end),
      (if ($task.isReady // false) | not
       then "\($id) waits on a dependency that is not Done." else empty end)
    end'

# Every outside program the check runs. check_dependencies reports each
# missing one before any work starts.
dependencies=(backlog git jq)

### Helpers begin
err() { echo "[!] $*" >&2; }
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it, then try again."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Answers whether a rebase or a bisect is under way in this repo.
in_rebase_or_bisect() {
  local path

  for path in rebase-merge rebase-apply BISECT_LOG; do
    if [[ -e "$(git rev-parse --git-path "${path}")" ]]; then
      return 0
    fi
  done
  return 1
}

main() {
  local branch
  local line
  local reasons
  local task_id

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "-h"|"--help") usage 0 ;;
      # The check prints only problems, so -q has nothing to hide.
      "-q"|"--quiet") ;;
      "-"*) usage 1 >&2 ;;
      *)
        err "daeshift-task-check takes no files. Give its hook" \
          "pass_filenames: false."
        exit 1
        ;;
    esac
    shift
  done

  if [[ -z "${DAESHIFT_PROJECT_ROOT:-}" || -z "${DAESHIFT_REPO_NAME:-}" ]]
  then
    err "DAESHIFT_PROJECT_ROOT or DAESHIFT_REPO_NAME is not set. Run" \
      "this check through daeshift's git hooks, which set them."
    exit 1
  fi
  check_dependencies || exit 1
  git rev-parse --git-dir >/dev/null || exit 1
  # A new repo's first commit, before any branch or tag exists.
  if [[ -z "$(git for-each-ref --count=1)" ]]; then
    exit 0
  fi
  if ! branch="$(git symbolic-ref --quiet --short HEAD)"; then
    # A rebase or bisect runs on a detached HEAD; other commits there
    # name no task.
    if in_rebase_or_bisect; then
      exit 0
    fi
    err "Commits on a detached HEAD name no task. Switch to a branch" \
      "named tasks/task-<id>-<slug> for a task In Progress."
    exit 1
  fi
  if [[ ! "${branch}" =~ ${BRANCH_TASK} ]]; then
    err "Branch ${branch} names no task. Work on a branch named" \
      "tasks/task-<id>-<slug> for a task In Progress."
    exit 1
  fi
  task_id="TASK-${BASH_REMATCH[1]}"
  if ! reasons="$(read_reasons "${task_id}")"; then
    err "The board in ${DAESHIFT_PROJECT_ROOT} could not be read, so" \
      "${task_id} cannot be checked."
    exit 1
  fi
  if [[ -n "${reasons}" ]]; then
    err "Branch ${branch} is not ready for commits:"
    while IFS= read -r line; do
      echo "    ${line}" >&2
    done <<<"${reasons}"
    exit 1
  fi
}

# Prints FIND_REASONS for task $1 in this repo, from the project's
# board. Fails when the board cannot be read.
read_reasons() {
  local tasks

  tasks="$(cd "${DAESHIFT_PROJECT_ROOT}" && backlog task list --json)" \
    || return 1
  jq -r --arg id "$1" --arg repo "${DAESHIFT_REPO_NAME}" \
    "${FIND_REASONS}" <<<"${tasks}" || return 1
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: daeshift-task-check [OPTIONS]

DESCRIPTION
    Reject a commit unless the branch names a task that is on the
    project's board, In Progress, with acceptance criteria, for this
    repo, with no subtasks and no unfinished dependency. Run by
    daeshift's git hooks in a code repo.

OPTIONS
    -h, --help       Display this help message
    -q, --quiet      Show only warnings and errors
EOF
  exit "$1"
}

main "$@"
