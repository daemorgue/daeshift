#!/usr/bin/env bash

# daeshift's git hook dispatcher. git runs it for every repo under
# $DAESHIFT_HOME/local/projects/ (see git/gitconfig). Every other file in
# git/hooks/ is a link to this one, and the script reads its own name to
# know which hook it is. For pre-commit, pre-merge-commit, commit-msg and
# pre-push it finds the repo's project and hands the hook to pre-commit
# with the repo's configs from the project repo
# (.config/pre-commit/_code.yaml for every code repo, then <repo>.yaml;
# _project.yaml for the project repo itself), telling the hooks where
# they run: DAESHIFT_PROJECT_ROOT (the project folder),
# DAESHIFT_REPO_KIND ("project" or "code") and DAESHIFT_REPO_NAME (the
# repo's name, or "_project"). For every hook it then runs the repo's
# own hook of the same name, if any, since setting core.hooksPath stops
# git from running them. git runs it; it takes no options of its own.

set -o nounset
set -o pipefail

readonly CONFIG_DIR=".config/pre-commit"

# Every outside program the dispatcher runs. check_dependencies reports
# each missing one before any work starts.
dependencies=(cat git mktemp rm)
# The file holding git's standard input for pre-push, or /dev/null. Not
# local to main: the EXIT trap that removes it runs after main returns.
stdin_file="/dev/null"

### Helpers begin
err() { echo "[!] $*" >&2; }
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Prints the pre-commit program to run: daeshift's own pinned copy under
# DAESHIFT_HOME. Fails when it is missing; an unpinned pre-commit on
# PATH is never used (decision-9).
find_pre_commit() {
  local daeshift_home="${HOME}/.daeshift"
  local own_copy

  if [[ -n "${DAESHIFT_HOME:-}" ]]; then
    daeshift_home="${DAESHIFT_HOME}"
  fi
  own_copy="${daeshift_home}/local/tools/pre-commit/bin/pre-commit"
  if [[ -x "${own_copy}" ]]; then
    echo "${own_copy}"
  else
    err "pre-commit was not found. Install it, pinned, into" \
      "${daeshift_home}/local/tools/pre-commit as daeshift's README" \
      "describes under Pinned tools."
    return 1
  fi
}

# Prints the project folder repo $1 belongs to: the first folder under
# projects folder $2. Prints nothing when the repo is not under it.
find_project_root() {
  local project_name
  local relative

  if [[ "$1" != "$2/"* ]]; then
    return 0
  fi
  relative="${1#"$2/"}"
  project_name="${relative%%/*}"
  echo "$2/${project_name}"
}

main() {
  local common_dir
  local config
  local configs
  local daeshift_home="${HOME}/.daeshift"
  local hook_name="${0##*/}"
  local project_root
  local projects_dir
  local repo_name
  local repo_top

  # No option loop: every argument is git's and passes through as is.
  # This is a deliberate exception to the bash skill's -h/-q rule, as in
  # pre-commit's own hook template.
  check_dependencies || exit 1
  if [[ "${hook_name}" != "pre-commit" && "${hook_name}" != "commit-msg" \
    && "${hook_name}" != "pre-merge-commit" \
    && "${hook_name}" != "pre-push" ]]; then
    run_own_hook "${hook_name}" "$@" || exit 1
    exit 0
  fi
  # git feeds pre-push its refs on standard input; keep them for every
  # pre-commit call and the repo's own hook.
  if [[ "${hook_name}" == "pre-push" ]]; then
    stdin_file="$(mktemp)" || exit 1
    trap 'rm -f "${stdin_file}"' EXIT
    cat > "${stdin_file}" || exit 1
  fi
  if [[ -n "${DAESHIFT_HOME:-}" ]]; then
    daeshift_home="${DAESHIFT_HOME}"
  fi
  # The main checkout, so a linked worktree uses its repo's config.
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir)" \
    || exit 1
  if [[ "${common_dir}" != /* ]]; then
    err "git could not give an absolute path for this repo; daeshift's" \
      "hooks need git 2.31 or later."
    exit 1
  fi
  repo_top="${common_dir%/.git}"
  # Both sides as physical paths, since git reports one.
  projects_dir="$(cd "${daeshift_home}/local/projects" 2>/dev/null \
    && pwd -P)" || projects_dir=""
  if [[ -n "${projects_dir}" ]]; then
    project_root="$(find_project_root "${repo_top}" "${projects_dir}")" \
      || exit 1
  else
    project_root=""
  fi
  if [[ -n "${project_root}" ]]; then
    if [[ "${repo_top}" == "${project_root}" ]]; then
      repo_name="_project"
      export DAESHIFT_REPO_KIND="project"
    else
      repo_name="${repo_top##*/}"
      export DAESHIFT_REPO_KIND="code"
    fi
    export DAESHIFT_PROJECT_ROOT="${project_root}"
    export DAESHIFT_REPO_NAME="${repo_name}"
    # A code repo runs the project's shared _code.yaml first, then its
    # own file; the project repo runs _project.yaml alone.
    configs=("${repo_name}")
    if [[ "${DAESHIFT_REPO_KIND}" == "code" && "${repo_name}" != "_code" ]]
    then
      configs=("_code" "${repo_name}")
    fi
    for config in "${configs[@]}"; do
      config="${project_root}/${CONFIG_DIR}/${config}.yaml"
      if [[ -f "${config}" ]]; then
        run_pre_commit "${config}" "${hook_name}" "$@" \
          < "${stdin_file}" || exit 1
      fi
    done
  fi
  if [[ "${hook_name}" == "pre-push" ]]; then
    run_own_hook "${hook_name}" "$@" < "${stdin_file}" || exit 1
  else
    run_own_hook "${hook_name}" "$@" || exit 1
  fi
}

# Runs the repo's own hook named $1 from its .git/hooks folder, passing
# the rest of the arguments. Does nothing when there is none; fails when
# it fails.
run_own_hook() {
  local git_dir
  local own_hook

  # The common folder, so a linked worktree finds the repo's hooks too.
  git_dir="$(git rev-parse --git-common-dir)" || return 1
  own_hook="${git_dir}/hooks/$1"
  shift
  if [[ -x "${own_hook}" ]]; then
    "${own_hook}" "$@" || return 1
  fi
}

# Runs pre-commit with config file $1 for hook $2 (pre-commit,
# pre-merge-commit, commit-msg or pre-push), handing it the rest of the
# arguments and standard input untouched, the way pre-commit's own
# installed hooks do. daeshift's own checks, in the checks folder beside
# this script, are put on PATH so a config names them by command alone,
# and DAESHIFT_PRE_COMMIT names the pinned pre-commit for checks that
# need it. Fails when any hook fails.
run_pre_commit() {
  # git runs hooks by their absolute path, so $0's folder is this one.
  local checks_dir="${0%/*}/checks"
  local config="$1"
  local hook_name="$2"
  local pre_commit

  shift 2
  pre_commit="$(find_pre_commit)" || return 1
  DAESHIFT_PRE_COMMIT="${pre_commit}" PATH="${checks_dir}:${PATH}" \
    "${pre_commit}" hook-impl --config="${config}" \
    --hook-type="${hook_name}" --hook-dir="${0%/*}" -- "$@"
}

main "$@"
