#!/usr/bin/env bash

# install: set up, update or roll back daeshift on this machine. Checks
# the prerequisites and the clone, lists every change, asks once, then
# makes the changes: check out a release, create local/, install the
# pinned tools into local/tools/, and set up the board and map services
# that local/config.yaml asks for. Started by "daeshift --install",
# "--update" or "--release TAG"; run "install --help" for usage.

set -o nounset
set -o pipefail

# The global git setting that turns on daeshift's hooks for every repo
# under ~/.daeshift/local/projects/ (decision-14). git expands the ~.
readonly HOOKS_KEY='includeIf.gitdir:~/.daeshift/local/projects/.path'
# shellcheck disable=SC2088
readonly HOOKS_VALUE='~/.daeshift/git/gitconfig'
readonly NAME_PATTERN='^[A-Za-z0-9][A-Za-z0-9._-]*$'
readonly PORT_PATTERN='^[1-9][0-9]{0,4}$'
# One line per service in config.yaml: kind, project, repo ("-" for a
# board) and port, separated by tabs. $p is yq's, not the shell's.
# shellcheck disable=SC2016
readonly SERVICES_QUERY='(.projects // {}) | to_entries | .[] | .key as $p
  | ((select(.value.board != null)
      | "board\t" + $p + "\t-\t" + (.value.board | tostring)),
    ((.value.repos // {}) | to_entries | .[]
      | "map\t" + $p + "\t" + .key + "\t" + (.value | tostring)))'
readonly UNIT_MARKER="# Written by daeshift --install"
readonly VERSION_PATTERN='[0-9]+(\.[0-9]+)+'

# Every outside program install runs. check_dependencies reports each
# missing one before any work starts.
# npm and python3 are checked with the prerequisites, which name the
# version needed.
dependencies=(cat cp dirname git grep id ln mkdir rm shasum uname)
quiet="false"
# Filled by plan_services: the changes to list, whether config.yaml
# asks for any service, the units to write with their text, and the
# units daeshift wrote that config.yaml no longer asks for.
service_changes=()
services_configured="false"
stale_units=()
unit_names=()
unit_texts=()

### Helpers begin
err() { echo "[!] $*" >&2; }

good() {
  if [[ "${quiet}" == "false" ]]; then
    echo "[+] $*"
  fi
}

info() {
  if [[ "${quiet}" == "false" ]]; then
    echo "[*] $*"
  fi
}

warn() { echo "[-] $*"; }
### Helpers end

# Makes the service changes plan_services planned, in units folder $1:
# removes the stale units, writes the others, enables and restarts them.
apply_services() {
  local index=0

  mkdir -p "$1" || return 1
  while [[ ${index} -lt ${#stale_units[@]} ]]; do
    systemctl --user --quiet disable --now "${stale_units[index]}" \
      || return 1
    rm -f "$1/${stale_units[index]}" || return 1
    good "Removed service ${stale_units[index]}"
    index=$((index + 1))
  done
  index=0
  while [[ ${index} -lt ${#unit_names[@]} ]]; do
    printf '%s\n' "${unit_texts[index]}" > "$1/${unit_names[index]}" \
      || return 1
    index=$((index + 1))
  done
  systemctl --user daemon-reload || return 1
  index=0
  while [[ ${index} -lt ${#unit_names[@]} ]]; do
    systemctl --user --quiet enable "${unit_names[index]}" || return 1
    systemctl --user restart "${unit_names[index]}" || return 1
    good "Started service ${unit_names[index]}"
    index=$((index + 1))
  done
}

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Checks each program in prerequisites file $1: present, and at least
# its minimum version. Reports every failure, then fails if any.
check_prerequisites() {
  local command_words=()
  local failed="false"
  local found
  local line_rest
  local minimum
  local name
  local output

  if [[ ! -r "$1" ]]; then
    err "$1 was not found. Check that the clone is complete."
    return 1
  fi
  while read -r name minimum line_rest; do
    if [[ -z "${name}" || "${name}" == "#"* ]]; then
      continue
    fi
    read -r -a command_words <<<"${line_rest}"
    if ! command -v "${name}" >/dev/null 2>&1; then
      if [[ "${minimum}" == "-" ]]; then
        err "${name} was not found. Install it, then try again."
      else
        err "${name} was not found. Install ${name} ${minimum} or later," \
          "then try again."
      fi
      failed="true"
      continue
    fi
    if [[ "${minimum}" == "-" ]]; then
      continue
    fi
    # Run as words, never through a shell, and away from the prompt's
    # standard input.
    output="$("${command_words[@]}" 2>&1 </dev/null)"
    found="unknown"
    if [[ "${output}" =~ ${VERSION_PATTERN} ]]; then
      found="${BASH_REMATCH[0]}"
    fi
    if [[ "${found}" == "unknown" ]] \
      || ! version_at_least "${found}" "${minimum}"; then
      err "${name} ${found} was found; daeshift needs ${name}" \
        "${minimum} or later."
      failed="true"
    fi
  done < "$1"
  if [[ "${failed}" == "true" ]]; then
    return 1
  fi
}

# Checks one service from config.yaml under local folder $1: project $2
# exists, repo $3 ("-" for a board) is listed in the project's
# .config/repos.yaml and cloned, and port $4 is from 1024 to 65535 and
# not among the ports $5. Says what is wrong; fails if anything is.
check_service() {
  local config="$1/config.yaml"
  local project_dir="$1/projects/$2"
  local service="the map of $2/$3"

  if [[ "$3" == "-" ]]; then
    service="the board of $2"
  fi
  if [[ ! "$2" =~ ${NAME_PATTERN} || ! -d "${project_dir}" ]]; then
    err "${config}: there is no project '$2' in $1/projects."
    return 1
  fi
  if [[ ! "$4" =~ ${PORT_PATTERN} ]] || (( $4 < 1024 || $4 > 65535 )); then
    err "${config}: port '$4' of ${service} is not a number from 1024" \
      "to 65535."
    return 1
  fi
  if [[ "$5" == *" $4 "* ]]; then
    err "${config}: port $4 is used twice. Give each service its own."
    return 1
  fi
  if [[ "$3" == "-" ]]; then
    return 0
  fi
  if [[ ! "$3" =~ ${NAME_PATTERN} ]] \
    || ! "$1/tools/bin/yq" '.repos[].name' \
      "${project_dir}/.config/repos.yaml" \
      | grep --fixed-strings --line-regexp --quiet -- "$3"; then
    err "${config}: repo '$3' is not listed in" \
      "${project_dir}/.config/repos.yaml."
    return 1
  fi
  if [[ ! -d "${project_dir}/repositories/$3" ]]; then
    err "${project_dir}/repositories/$3 does not exist. Clone $3 there," \
      "then try again."
    return 1
  fi
}

# Installs the pinned tools of code folder $1 into tools folder $2. The
# stamp $3 is removed first and written last, so a failed run is tried
# again next time. Says which step failed.
install_tools() {
  local code_dir="$1"
  local stamp="$3"
  local tools_dir="$2"
  local venv

  rm -f "${stamp}" || return 1
  if ! "${code_dir}/ci/install-tools" -q "${tools_dir}"; then
    err "Installing bats, ShellCheck and yq failed. Run daeshift" \
      "--install again."
    return 1
  fi
  for venv in pre-commit tiredize; do
    rm -rf "${tools_dir:?}/${venv}"
    if ! python3 -m venv "${tools_dir}/${venv}" \
      || ! "${tools_dir}/${venv}/bin/pip" install --quiet \
        --require-hashes --only-binary :all: \
        -r "${code_dir}/requirements/${venv}.txt"; then
      err "Installing ${venv} failed. Run daeshift --install again."
      return 1
    fi
  done
  ln -sf "${tools_dir}/tiredize/bin/tiredize" "${tools_dir}/bin/tiredize" \
    || return 1
  mkdir -p "${tools_dir}/node" || return 1
  cp "${code_dir}/requirements/npm/package.json" \
    "${code_dir}/requirements/npm/package-lock.json" "${tools_dir}/node/" \
    || return 1
  if ! npm ci --prefix "${tools_dir}/node" --ignore-scripts \
    --loglevel=error --no-audit --no-fund; then
    err "Installing backlog and groma failed. Run daeshift --install" \
      "again."
    return 1
  fi
  tools_stamp "${code_dir}" > "${stamp}" || return 1
  good "Pinned tools installed in ${tools_dir}"
}

main() {
  local answer
  local changes=()
  local code_dir
  local daeshift_home="${HOME}/.daeshift"
  local hooks_off="false"
  local local_dir
  local release=""
  local release_option=""
  local script_dir
  local stamp
  local units_dir="${HOME}/.config/systemd/user"
  local update="false"
  local wanted=""
  local services_later="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "-h"|"--help") usage 0 ;;
      "-q"|"--quiet") quiet="true" ;;
      "--release")
        if [[ $# -lt 2 || -z "$2" ]]; then
          usage 1 >&2
        fi
        release_option="$2"
        shift
        ;;
      "--update") update="true" ;;
      *) usage 1 >&2 ;;
    esac
    shift
  done
  if [[ -n "${DAESHIFT_HOME:-}" ]]; then
    daeshift_home="${DAESHIFT_HOME}"
  fi
  # --release wins over --update, as in bin/daeshift.
  if [[ -n "${release_option}" ]]; then
    wanted="${release_option}"
  elif [[ "${update}" == "true" ]]; then
    wanted="newest"
  fi

  # bash 5.2 replaces & in ${text//x/y} with the match; render_unit needs
  # every path as written. bash 3.2 lacks the option.
  shopt -u patsub_replacement 2>/dev/null
  check_dependencies || exit 1
  script_dir="$(dirname "$0")" || exit 1
  code_dir="$(cd "${script_dir}/.." && pwd)" || exit 1
  local_dir="${daeshift_home}/local"
  stamp="${local_dir}/tools/installed-from"

  check_prerequisites "${code_dir}/requirements/prerequisites" || exit 1
  # Tags only: fetching origin/main too would make a fresh clone look
  # moved.
  if [[ -n "${wanted}" ]] && ! git -C "${code_dir}" fetch --quiet origin \
    '+refs/tags/*:refs/tags/*'; then
    err "Fetching the releases from origin failed. Check the network," \
      "then try again."
    exit 1
  fi
  release="$(pick_release "${code_dir}" "${local_dir}" "${wanted}")" \
    || exit 1
  if [[ -n "${release}" ]]; then
    # The release's own list, which may ask for newer versions.
    check_prerequisites <(git -C "${code_dir}" show \
      "refs/tags/${release}:requirements/prerequisites") || exit 1
  fi

  if [[ -n "${release}" ]]; then
    changes+=("check out release ${release} in ${code_dir}")
  fi
  if [[ ! -d "${local_dir}/projects" ]]; then
    changes+=("create ${local_dir}/projects")
  fi
  if [[ ! -f "${local_dir}/config.yaml" ]]; then
    changes+=("write ${local_dir}/config.yaml with the line runner: pi")
  fi
  if [[ -n "${release}" ]] || ! tools_current "${code_dir}" "${stamp}"; then
    changes+=("install the pinned tools into ${local_dir}/tools")
  fi
  if ! git config --global --get "${HOOKS_KEY}" >/dev/null; then
    hooks_off="true"
    changes+=("turn on daeshift's git hooks in the global git config")
  fi
  # Services are read with the pinned yq and filled in from the checked
  # out templates, so a config that comes before the tools or a release
  # waits for the next run.
  if [[ -f "${local_dir}/config.yaml" ]] \
    && [[ -n "${release}" || ! -x "${local_dir}/tools/bin/yq" ]]; then
    services_later="true"
  elif ! plan_services "${code_dir}" "${local_dir}" "${units_dir}"; then
    exit 1
  fi
  if [[ ${#service_changes[@]} -gt 0 ]]; then
    changes+=("${service_changes[@]}")
  fi
  if [[ ${#changes[@]} -eq 0 ]]; then
    good "Nothing to change."
    print_next_steps "${code_dir}" "${local_dir}"
    exit 0
  fi

  echo "daeshift will make these changes:"
  printf '  - %s\n' "${changes[@]}"
  printf 'Make these changes? [y/N] '
  read -r answer || answer=""
  case "${answer}" in
    [yY]|[yY][eE][sS]) ;;
    *)
      warn "Nothing changed."
      exit 1
      ;;
  esac

  if [[ -n "${release}" ]]; then
    git -C "${code_dir}" -c advice.detachedHead=false checkout --quiet \
      "refs/tags/${release}" || exit 1
    good "Checked out ${release}"
  fi
  if [[ ! -d "${local_dir}/projects" ]]; then
    mkdir -p "${local_dir}/projects" || exit 1
    good "Created ${local_dir}/projects"
  fi
  if [[ ! -f "${local_dir}/config.yaml" ]]; then
    echo "runner: pi" > "${local_dir}/config.yaml" || exit 1
    good "Wrote ${local_dir}/config.yaml"
  fi
  if ! tools_current "${code_dir}" "${stamp}"; then
    info "Installing the pinned tools; this takes a minute"
    install_tools "${code_dir}" "${local_dir}/tools" "${stamp}" || exit 1
  elif [[ -n "${release}" ]]; then
    good "Pinned tools already current"
  fi
  if [[ "${hooks_off}" == "true" ]]; then
    git config --global "${HOOKS_KEY}" "${HOOKS_VALUE}" || exit 1
    good "Turned on daeshift's git hooks in the global git config"
  fi
  if [[ ${#service_changes[@]} -gt 0 ]]; then
    apply_services "${units_dir}" || exit 1
  fi
  if [[ "${services_later}" == "true" ]]; then
    warn "Run daeshift --install again to set up the services in" \
      "${local_dir}/config.yaml, if it has any."
  fi
  print_next_steps "${code_dir}" "${local_dir}"
}

# Prints the release tag to check out in clone $1, or nothing when the
# clone is already there. $3 is the wanted release: empty to stay at the
# current one (a fresh clone on main gets the newest), "newest", or a
# tag. Fails, saying why, for a clone inside local folder $2, a clone
# with changes, one neither at a release nor fresh, an unknown tag, or a
# release from before the installer.
pick_release() {
  local branch
  local clone="$1"
  local current
  local local_dir
  local newest
  local status
  local tags_here
  local target

  # Physical paths, so a symbolic link or a trailing / cannot hide a
  # clone inside local/. A local/ not created yet holds no clone.
  local_dir="$2"
  if [[ -d "$2" ]]; then
    local_dir="$(cd "$2" && pwd -P)" || return 1
  fi
  clone="$(cd "${clone}" && pwd -P)" || return 1
  case "${clone}/" in
    "${local_dir%/}/"*)
      err "daeshift is cloned inside $2. Clone it to the folder above" \
        "local/ instead, then run daeshift --install from there."
      return 1
      ;;
  esac
  status="$(git -C "${clone}" status --porcelain --untracked-files=normal)" \
    || return 1
  if [[ -n "${status}" ]]; then
    err "${clone} has changes. Commit, stash or remove them, then try" \
      "again."
    return 1
  fi
  newest="$(git -C "${clone}" tag --list 'v*' --sort=-v:refname)" \
    || return 1
  newest="${newest%%$'\n'*}"
  tags_here="$(git -C "${clone}" tag --points-at HEAD --list 'v*')" \
    || return 1
  current="${tags_here%%$'\n'*}"
  if [[ -z "${current}" ]]; then
    branch="$(git -C "${clone}" branch --show-current)" || return 1
    if [[ "${branch}" != "main" || -z "${newest}" ]] \
      || [[ "$(git -C "${clone}" rev-parse HEAD)" \
        != "$(git -C "${clone}" rev-parse origin/main 2>/dev/null)" ]]; then
      err "${clone} is not at a release tag. Check one out, such as:" \
        "git -C ${clone} checkout ${newest:-<tag>}"
      return 1
    fi
  fi

  case "$3" in
    "") target="${current:-${newest}}" ;;
    "newest") target="${newest}" ;;
    *)
      if ! git -C "${clone}" rev-parse --verify --quiet "refs/tags/$3" \
        >/dev/null; then
        err "No release $3. List the releases with: git -C ${clone} tag" \
          "--list 'v*'"
        return 1
      fi
      target="$3"
      ;;
  esac
  case $'\n'"${tags_here}"$'\n' in
    *$'\n'"${target}"$'\n'*) return 0 ;;
  esac
  if ! git -C "${clone}" cat-file -e "refs/tags/${target}:libexec/install" \
    2>/dev/null; then
    err "Release ${target} has no daeshift --install, so daeshift could" \
      "not update from it. Choose a newer release."
    return 1
  fi
  echo "${target}"
}

# Plans the board and map services that config.yaml in local folder $2
# asks for, from the templates in code folder $1, against the units in
# folder $3. Fills service_changes, stale_units, unit_names and
# unit_texts. Warns when the machine has no systemd or linger is off.
# Fails, saying why, for a config it cannot read or a service it cannot
# set up.
plan_services() {
  local config="$2/config.yaml"
  local entries
  local failed="false"
  local first_line
  local kind
  local name
  local port
  local project
  local repo
  local text
  local unit
  local used_ports=" "
  local wanted=" "
  local yq="$2/tools/bin/yq"

  if [[ ! -f "${config}" || ! -x "${yq}" ]]; then
    return 0
  fi
  if ! entries="$("${yq}" "${SERVICES_QUERY}" "${config}")"; then
    err "${config} could not be read. Fix it, then try again."
    return 1
  fi
  if [[ "$(uname -s)" != "Linux" ]] \
    || ! command -v systemctl >/dev/null 2>&1; then
    if [[ -n "${entries}" ]]; then
      warn "${config} sets services, but they need systemd, which this" \
        "machine lacks; none is set up."
    fi
    return 0
  fi
  while IFS=$'\t' read -r kind project repo port; do
    if [[ -z "${kind}" ]]; then
      continue
    fi
    if ! check_service "$2" "${project}" "${repo}" "${port}" \
      "${used_ports}"; then
      failed="true"
      continue
    fi
    used_ports+="${port} "
    if [[ "${kind}" == "board" ]]; then
      name="backlog-${project}.service"
      text="$(render_unit "$1/services/systemd/backlog.service" \
        "${project}" "$2/projects/${project}" "${port}" "$2")" || return 1
    else
      name="groma-${project}-${repo}.service"
      text="$(render_unit "$1/services/systemd/groma.service" "${repo}" \
        "$2/projects/${project}/repositories/${repo}" "${port}" "$2")" \
        || return 1
    fi
    if [[ "${wanted}" == *" ${name} "* ]]; then
      err "${config}: two services would share the unit ${name}. Rename" \
        "a project or repo."
      failed="true"
      continue
    fi
    wanted+="${name} "
    unit="$3/${name}"
    if [[ -f "${unit}" ]]; then
      IFS= read -r first_line < "${unit}"
      if [[ "${first_line}" != "${UNIT_MARKER}"* ]]; then
        err "${unit} was not written by daeshift. Move it away, then try" \
          "again."
        failed="true"
        continue
      fi
      if [[ "$(cat "${unit}")" != "${text}" ]]; then
        service_changes+=("update service ${name}")
      elif ! systemctl --user --quiet is-enabled "${name}"; then
        service_changes+=("start service ${name}")
      else
        continue
      fi
    else
      service_changes+=("set up service ${name} on port ${port}")
    fi
    unit_names+=("${name}")
    unit_texts+=("${text}")
  done <<<"${entries}"
  if [[ "${failed}" == "true" ]]; then
    return 1
  fi

  for unit in "$3"/*.service; do
    name="${unit##*/}"
    if [[ ! -f "${unit}" || "${wanted}" == *" ${name} "* ]]; then
      continue
    fi
    IFS= read -r first_line < "${unit}"
    if [[ "${first_line}" == "${UNIT_MARKER}"* ]]; then
      service_changes+=("remove service ${name}")
      stale_units+=("${name}")
    fi
  done
  if [[ "${wanted}" != " " ]]; then
    services_configured="true"
  fi
}

# Prints the lines to add by hand that this machine still lacks: the
# PATH folders from code folder $1 and local folder $2, a git identity,
# and linger for the services.
print_next_steps() {
  local folders="$1/bin:$2/tools/bin:$2/tools/node/node_modules/.bin"

  case ":${PATH}:" in
    *":$1/bin:"*) ;;
    *)
      warn "Add daeshift to PATH in your shell profile:" \
        "export PATH=\"${folders}:\${PATH}\""
      ;;
  esac
  if [[ "${services_configured}" == "true" \
    && "$(loginctl show-user "$(id -un)" --property=Linger --value)" \
      != "yes" ]]; then
    warn "Services stop when you log out and do not start at boot. Keep" \
      "them running with: sudo loginctl enable-linger $(id -un)"
  fi
  if [[ -z "$(git config --global user.name)" \
    || -z "$(git config --global user.email)" ]]; then
    warn "git has no identity yet: git config --global user.name" \
      "\"Your Name\"; git config --global user.email you@example.com"
  fi
}

# Prints unit template $1 filled in for name $2, working folder $3 and
# port $4, with the pinned tools of local folder $5 and node on PATH.
# A % in a path is doubled, as systemd reads %x as a specifier.
render_unit() {
  local folder="${3//%/%%}"
  local local_dir="${5//%/%%}"
  local node
  local path
  local text
  local tools

  node="$(command -v node)" || return 1
  node="${node//%/%%}"
  tools="${local_dir}/tools/node/node_modules/.bin"
  path="${tools}:${local_dir}/tools/bin:${node%/*}:/usr/local/bin:/usr/bin"
  path+=":/bin"
  text="$(cat "$1")" || return 1
  text="${text//@FOLDER@/${folder}}"
  text="${text//@NAME@/$2}"
  text="${text//@PATH@/${path}}"
  text="${text//@PORT@/$4}"
  echo "${text//@TOOLS@/${tools}}"
}

# Answers whether stamp file $2 matches the pinned tool lists of code
# folder $1.
tools_current() {
  local wanted

  if [[ ! -f "$2" ]]; then
    return 1
  fi
  wanted="$(tools_stamp "$1")" || return 1
  [[ "$(cat "$2")" == "${wanted}" ]]
}

# Prints one SHA-256 over every file that pins a tool in code folder $1.
tools_stamp() {
  local sum

  sum="$(cat "$1/ci/install-tools" "$1/requirements/pre-commit.txt" \
    "$1/requirements/tiredize.txt" "$1/requirements/npm/package-lock.json" \
    | shasum -a 256)" || return 1
  echo "${sum%% *}"
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: install [OPTIONS]

DESCRIPTION
    Set up, update or roll back daeshift on this machine: check the
    prerequisites and the clone, list every change and ask, then
    install.

OPTIONS
    -h, --help       Display this help message
    -q, --quiet      Show only warnings and errors
        --release TAG
                     Check out the release TAG, such as an older one to
                     roll back to; wins over --update
        --update     Check out the newest release
EOF
  exit "$1"
}

# Answers whether version $1 is at least version $2, comparing each
# dot-separated number in turn; a missing number counts as 0.
version_at_least() {
  local found=()
  local index=0
  local minimum=()

  IFS='.' read -r -a found <<<"$1"
  IFS='.' read -r -a minimum <<<"$2"
  while [[ ${index} -lt ${#minimum[@]} ]]; do
    if (( 10#${found[index]:-0} > 10#${minimum[index]} )); then
      return 0
    fi
    if (( 10#${found[index]:-0} < 10#${minimum[index]} )); then
      return 1
    fi
    index=$((index + 1))
  done
}

main "$@"
