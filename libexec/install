#!/usr/bin/env bash

# install: set up, update or roll back daeshift on this machine. Checks
# the prerequisites and the clone, lists every change, asks once, then
# makes the changes: check out a release, create local/, and install the
# pinned tools into local/tools/. Started by "daeshift --install",
# "--update" or "--release TAG"; run "install --help" for usage.

set -o nounset
set -o pipefail

readonly VERSION_PATTERN='[0-9]+(\.[0-9]+)+'

# Every outside program install runs. check_dependencies reports each
# missing one before any work starts.
# npm and python3 are checked with the prerequisites, which name the
# version needed.
dependencies=(cat cp dirname git ln mkdir rm shasum)
quiet="false"

### Helpers begin
err() { echo "[!] $*" >&2; }

good() {
  if [[ "${quiet}" == "false" ]]; then
    echo "[+] $*"
  fi
}

info() {
  if [[ "${quiet}" == "false" ]]; then
    echo "[*] $*"
  fi
}

warn() { echo "[-] $*"; }
### Helpers end

# Reports every program in dependencies that is missing. Fails if any
# is missing.
check_dependencies() {
  local missing="false"
  local program

  for program in "${dependencies[@]}"; do
    if ! command -v "${program}" >/dev/null 2>&1; then
      err "${program} was not found. Install it with your system's" \
        "package manager."
      missing="true"
    fi
  done
  if [[ "${missing}" == "true" ]]; then
    return 1
  fi
}

# Checks each program in prerequisites file $1: present, and at least
# its minimum version. Reports every failure, then fails if any.
check_prerequisites() {
  local command_words=()
  local failed="false"
  local found
  local line_rest
  local minimum
  local name
  local output

  if [[ ! -r "$1" ]]; then
    err "$1 was not found. Check that the clone is complete."
    return 1
  fi
  while read -r name minimum line_rest; do
    if [[ -z "${name}" || "${name}" == "#"* ]]; then
      continue
    fi
    read -r -a command_words <<<"${line_rest}"
    if ! command -v "${name}" >/dev/null 2>&1; then
      if [[ "${minimum}" == "-" ]]; then
        err "${name} was not found. Install it, then try again."
      else
        err "${name} was not found. Install ${name} ${minimum} or later," \
          "then try again."
      fi
      failed="true"
      continue
    fi
    if [[ "${minimum}" == "-" ]]; then
      continue
    fi
    # Run as words, never through a shell, and away from the prompt's
    # standard input.
    output="$("${command_words[@]}" 2>&1 </dev/null)"
    found="unknown"
    if [[ "${output}" =~ ${VERSION_PATTERN} ]]; then
      found="${BASH_REMATCH[0]}"
    fi
    if [[ "${found}" == "unknown" ]] \
      || ! version_at_least "${found}" "${minimum}"; then
      err "${name} ${found} was found; daeshift needs ${name}" \
        "${minimum} or later."
      failed="true"
    fi
  done < "$1"
  if [[ "${failed}" == "true" ]]; then
    return 1
  fi
}

# Installs the pinned tools of code folder $1 into tools folder $2. The
# stamp $3 is removed first and written last, so a failed run is tried
# again next time. Says which step failed.
install_tools() {
  local code_dir="$1"
  local stamp="$3"
  local tools_dir="$2"
  local venv

  rm -f "${stamp}" || return 1
  if ! "${code_dir}/ci/install-tools" -q "${tools_dir}"; then
    err "Installing bats, ShellCheck and yq failed. Run daeshift" \
      "--install again."
    return 1
  fi
  for venv in pre-commit tiredize; do
    rm -rf "${tools_dir:?}/${venv}"
    if ! python3 -m venv "${tools_dir}/${venv}" \
      || ! "${tools_dir}/${venv}/bin/pip" install --quiet \
        --require-hashes --only-binary :all: \
        -r "${code_dir}/requirements/${venv}.txt"; then
      err "Installing ${venv} failed. Run daeshift --install again."
      return 1
    fi
  done
  ln -sf "${tools_dir}/tiredize/bin/tiredize" "${tools_dir}/bin/tiredize" \
    || return 1
  mkdir -p "${tools_dir}/node" || return 1
  cp "${code_dir}/requirements/npm/package.json" \
    "${code_dir}/requirements/npm/package-lock.json" "${tools_dir}/node/" \
    || return 1
  if ! npm ci --prefix "${tools_dir}/node" --ignore-scripts \
    --loglevel=error --no-audit --no-fund; then
    err "Installing backlog and groma failed. Run daeshift --install" \
      "again."
    return 1
  fi
  tools_stamp "${code_dir}" > "${stamp}" || return 1
  good "Pinned tools installed in ${tools_dir}"
}

main() {
  local answer
  local changes=()
  local code_dir
  local daeshift_home="${HOME}/.daeshift"
  local local_dir
  local release=""
  local script_dir
  local stamp
  local wanted=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "--")
        shift
        break
        ;;
      "-h"|"--help") usage 0 ;;
      "-q"|"--quiet") quiet="true" ;;
      "--release")
        if [[ $# -lt 2 || -z "$2" ]]; then
          usage 1 >&2
        fi
        wanted="$2"
        shift
        ;;
      "--update") wanted="newest" ;;
      *) usage 1 >&2 ;;
    esac
    shift
  done
  if [[ -n "${DAESHIFT_HOME:-}" ]]; then
    daeshift_home="${DAESHIFT_HOME}"
  fi

  check_dependencies || exit 1
  script_dir="$(dirname "$0")" || exit 1
  code_dir="$(cd "${script_dir}/.." && pwd)" || exit 1
  local_dir="${daeshift_home}/local"
  stamp="${local_dir}/tools/installed-from"

  check_prerequisites "${code_dir}/requirements/prerequisites" || exit 1
  if [[ -n "${wanted}" ]]; then
    git -C "${code_dir}" fetch --quiet --tags origin || exit 1
  fi
  release="$(pick_release "${code_dir}" "${local_dir}" "${wanted}")" \
    || exit 1

  if [[ -n "${release}" ]]; then
    changes+=("check out release ${release} in ${code_dir}")
  fi
  if [[ ! -d "${local_dir}/projects" ]]; then
    changes+=("create ${local_dir}/projects")
  fi
  if [[ ! -f "${local_dir}/config" ]]; then
    changes+=("write ${local_dir}/config with the line runner=pi")
  fi
  if [[ -n "${release}" ]] || ! tools_current "${code_dir}" "${stamp}"; then
    changes+=("install the pinned tools into ${local_dir}/tools")
  fi
  if [[ ${#changes[@]} -eq 0 ]]; then
    good "Nothing to change."
    print_next_steps "${code_dir}" "${local_dir}"
    exit 0
  fi

  echo "daeshift will make these changes:"
  printf '  - %s\n' "${changes[@]}"
  printf 'Make these changes? [y/N] '
  read -r answer || answer=""
  case "${answer}" in
    [yY]|[yY][eE][sS]) ;;
    *)
      warn "Nothing changed."
      exit 1
      ;;
  esac

  if [[ -n "${release}" ]]; then
    git -C "${code_dir}" -c advice.detachedHead=false checkout --quiet \
      "${release}" || exit 1
    good "Checked out ${release}"
  fi
  if [[ ! -d "${local_dir}/projects" ]]; then
    mkdir -p "${local_dir}/projects" || exit 1
    good "Created ${local_dir}/projects"
  fi
  if [[ ! -f "${local_dir}/config" ]]; then
    echo "runner=pi" > "${local_dir}/config" || exit 1
    good "Wrote ${local_dir}/config"
  fi
  if ! tools_current "${code_dir}" "${stamp}"; then
    info "Installing the pinned tools; this takes a minute"
    install_tools "${code_dir}" "${local_dir}/tools" "${stamp}" || exit 1
  elif [[ -n "${release}" ]]; then
    good "Pinned tools already current"
  fi
  print_next_steps "${code_dir}" "${local_dir}"
}

# Prints the release tag to check out in clone $1, or nothing when the
# clone is already there. $3 is the wanted release: empty to stay at the
# current one (a fresh clone on main gets the newest), "newest", or a
# tag. Fails, saying why, for a clone inside local folder $2, a clone
# with changes, one neither at a release nor fresh, or an unknown tag.
pick_release() {
  local branch
  local clone="$1"
  local current=""
  local local_dir
  local newest
  local status
  local target

  # Physical paths, so a symbolic link or a trailing / cannot hide a
  # clone inside local/. A local/ not created yet holds no clone.
  local_dir="$2"
  if [[ -d "$2" ]]; then
    local_dir="$(cd "$2" && pwd -P)" || return 1
  fi
  clone="$(cd "${clone}" && pwd -P)" || return 1
  case "${clone}/" in
    "${local_dir%/}/"*)
      err "daeshift is cloned inside $2. Clone it to the folder above" \
        "local/ instead, then run daeshift --install from there."
      return 1
      ;;
  esac
  status="$(git -C "${clone}" status --porcelain --untracked-files=normal)" \
    || return 1
  if [[ -n "${status}" ]]; then
    err "${clone} has changes. Commit, stash or remove them, then try" \
      "again."
    return 1
  fi
  newest="$(git -C "${clone}" tag --list 'v*' --sort=-v:refname)" \
    || return 1
  newest="${newest%%$'\n'*}"
  if ! current="$(git -C "${clone}" describe --tags --exact-match HEAD \
    2>/dev/null)"; then
    current=""
    branch="$(git -C "${clone}" branch --show-current)" || return 1
    if [[ "${branch}" != "main" || -z "${newest}" ]] \
      || [[ "$(git -C "${clone}" rev-parse HEAD)" \
        != "$(git -C "${clone}" rev-parse origin/main 2>/dev/null)" ]]; then
      err "${clone} is not at a release tag. Check one out, such as:" \
        "git -C ${clone} checkout ${newest:-<tag>}"
      return 1
    fi
  fi

  case "$3" in
    "") target="${current:-${newest}}" ;;
    "newest") target="${newest}" ;;
    *)
      if ! git -C "${clone}" rev-parse --verify --quiet "refs/tags/$3" \
        >/dev/null; then
        err "No release $3. List the releases with: git -C ${clone} tag" \
          "--list 'v*'"
        return 1
      fi
      target="$3"
      ;;
  esac
  if [[ "${target}" != "${current}" ]]; then
    echo "${target}"
  fi
}

# Prints the lines to add by hand that this machine still lacks: the
# PATH folders from code folder $1 and local folder $2, and a git
# identity.
print_next_steps() {
  local folders="$1/bin:$2/tools/bin:$2/tools/node/node_modules/.bin"

  case ":${PATH}:" in
    *":$1/bin:"*) ;;
    *)
      warn "Add daeshift to PATH in your shell profile:" \
        "export PATH=\"${folders}:\${PATH}\""
      ;;
  esac
  if [[ -z "$(git config --global user.name)" \
    || -z "$(git config --global user.email)" ]]; then
    warn "git has no identity yet: git config --global user.name" \
      "\"Your Name\"; git config --global user.email you@example.com"
  fi
}

# Answers whether stamp file $2 matches the pinned tool lists of code
# folder $1.
tools_current() {
  local wanted

  if [[ ! -f "$2" ]]; then
    return 1
  fi
  wanted="$(tools_stamp "$1")" || return 1
  [[ "$(cat "$2")" == "${wanted}" ]]
}

# Prints one SHA-256 over every file that pins a tool in code folder $1.
tools_stamp() {
  local sum

  sum="$(cat "$1/ci/install-tools" "$1/requirements/pre-commit.txt" \
    "$1/requirements/tiredize.txt" "$1/requirements/npm/package-lock.json" \
    | shasum -a 256)" || return 1
  echo "${sum%% *}"
}

# Prints the help text, then exits with the code it is given.
usage() {
  cat <<'EOF'
Usage: install [OPTIONS]

DESCRIPTION
    Set up, update or roll back daeshift on this machine: check the
    prerequisites and the clone, list every change and ask, then
    install.

OPTIONS
    -h, --help       Display this help message
    -q, --quiet      Show only warnings and errors
        --release TAG
                     Check out the release TAG, such as an older one to
                     roll back to
        --update     Check out the newest release
EOF
  exit "$1"
}

# Answers whether version $1 is at least version $2, comparing each
# dot-separated number in turn; a missing number counts as 0.
version_at_least() {
  local found=()
  local index=0
  local minimum=()

  IFS='.' read -r -a found <<<"$1"
  IFS='.' read -r -a minimum <<<"$2"
  while [[ ${index} -lt ${#minimum[@]} ]]; do
    if (( 10#${found[index]:-0} > 10#${minimum[index]} )); then
      return 0
    fi
    if (( 10#${found[index]:-0} < 10#${minimum[index]} )); then
      return 1
    fi
    index=$((index + 1))
  done
}

main "$@"
