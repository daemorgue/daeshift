#!/usr/bin/env bats

# Tests for git/hooks/checks/daeshift-no-ai-attribution. Each test gets
# its own home folder and writes the commit message it checks to
# ~/message.

# Fails the test when the text does not contain the expected part.
assert_contains() {
  if ! printf '%s\n' "$1" | grep --fixed-strings --quiet -- "$2"; then
    echo "expected to find: $2"
    echo "in: $1"
    return 1
  fi
}

# Fails the test when the first value is not the second.
assert_equal() {
  if [[ "$1" != "$2" ]]; then
    echo "expected: $2"
    echo "actual:   $1"
    return 1
  fi
}

setup() {
  export HOME="${BATS_TEST_TMPDIR}/home"
  mkdir -p "${HOME}"
  check="${BATS_TEST_DIRNAME}/../git/hooks/checks/daeshift-no-ai-attribution"
  message="${HOME}/message"
}

@test "daeshift-no-ai-attribution allows an ordinary message" {
  printf '%s\n' 'Fix the Claude runner settings' '' \
    'The lexer is generated by flex. Docs: https://claude.ai/code' \
    'Signed-off-by: Jane Doe <jane@example.com>' \
    '# Co-Authored-By: lines in git comments are not part of it' \
    > "${message}"
  run "${check}" "${message}"
  assert_equal "${status}" 0
  assert_equal "${output}" ""
}

@test "daeshift-no-ai-attribution ignores the diff below the scissors" {
  printf '%s\n' 'Fix the parser' '' \
    '# ------------------------ >8 ------------------------' \
    '+Co-Authored-By: Claude <noreply@anthropic.com>' > "${message}"
  run "${check}" "${message}"
  assert_equal "${status}" 0
}

@test "daeshift-no-ai-attribution rejects Claude Code's footer" {
  printf '%s\n' 'Fix the parser' '' \
    '🤖 Generated with [Claude Code](https://claude.com/claude-code)' \
    > "${message}"
  run "${check}" "${message}"
  assert_equal "${status}" 1
  assert_contains "${output}" "line 3: 🤖 Generated with"
}

@test "daeshift-no-ai-attribution rejects each credit trailer, even a person" {
  printf '%s\n' 'Fix the parser' '' \
    'co-authored-by: Jane Doe <jane@example.com>' 'Assisted-by: Tool' \
    'Generated-by: Tool' 'Made-with: Tool' 'Amp-Thread-ID: T-1' \
    > "${message}"
  run "${check}" "${message}"
  assert_equal "${status}" 1
  assert_contains "${output}" \
    "line 3: co-authored-by: Jane Doe <jane@example.com>"
  assert_contains "${output}" "line 4: Assisted-by: Tool"
  assert_contains "${output}" "line 5: Generated-by: Tool"
  assert_contains "${output}" "line 6: Made-with: Tool"
  assert_contains "${output}" "line 7: Amp-Thread-ID: T-1"
}
